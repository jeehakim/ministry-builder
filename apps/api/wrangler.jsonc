{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ministry-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Only the custom domains below are entry points; no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Production hostnames (DNS and TLS managed by Cloudflare; `wrangler deploy` attaches them).
  // api.build.shofar.ai is the API, on the shofar.ai zone next to the web app and the other shofar.ai apps.
  // sites.shofar.io stays on the shofar.io zone and serves published sites straight from the PUBLISHED
  // bucket (see src/hosting.ts); customer domains CNAME to it, so it does not move with the builder.
  "routes": [
    { "pattern": "api.build.shofar.ai", "custom_domain": true },
    { "pattern": "sites.shofar.io", "custom_domain": true }
  ],

  "vars": {
    // Origin of the web app: allowed by CORS, accepted as the Clerk token's authorized party, and the
    // base of every link back to the app (sites-host root redirect, invitation emails). Override per environment.
    "ALLOWED_ORIGIN": "https://build.shofar.ai",
    // Chat model used by the AI copilot on OpenAI. Overridable per environment.
    "OPENAI_MODEL": "gpt-5-mini",
    // Claude model used by the AI copilot on Anthropic (AI_PROVIDER=anthropic or only ANTHROPIC_API_KEY set).
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    // AI calls allowed per user per UTC day.
    "AI_DAILY_LIMIT": "30",
    // AI calls allowed per organization per UTC day, all members together.
    "AI_DAILY_LIMIT_ORG": "100",
    // AI calls allowed across every user per UTC day (a backstop; set a hard spend limit at the provider too, see README).
    "AI_GLOBAL_DAILY_LIMIT": "2000",
    // Per-user and per-site limits (see README). Sites per non-admin user across their organizations.
    "MAX_SITES_PER_USER": "10",
    // Bytes of uploaded images per site (100 MB).
    "MAX_SITE_STORAGE_BYTES": "104857600",
    // Saved versions per site; beyond this the oldest are pruned (never the current one or the newest 50).
    "MAX_VERSIONS_PER_SITE": "500",
    // Publishes per site per rolling hour.
    "MAX_PUBLISHES_PER_HOUR": "20",
    // Custom domains per site, and across every site a non-admin user owns.
    "MAX_DOMAINS_PER_SITE": "3",
    "MAX_DOMAINS_PER_USER": "10",
    // Hostname that serves published sites (path form: sites.shofar.io/<slug>/).
    "PUBLIC_SITES_HOST": "sites.shofar.io",
    // This API's own hostname; the hosting handler never treats it as a customer domain.
    "PUBLIC_API_HOST": "api.build.shofar.ai",
    // Customers CNAME their domain here (any proxied hostname on the shofar.io zone, see README).
    "CUSTOM_HOSTNAME_CNAME_TARGET": "sites.shofar.io",
    // Zone id of shofar.io (dashboard: zone Overview > API). With CLOUDFLARE_API_TOKEN (a secret)
    // it enables customer domains through Cloudflare for SaaS custom hostnames.
    "CLOUDFLARE_ZONE_ID": "",
    // Contact-form notification emails: "cloudflare" (send_email binding below), "resend" (RESEND_API_KEY secret)
    // or "none" (store messages only; owners read them through GET /sites/:id/messages).
    "EMAIL_PROVIDER": "none",
    "EMAIL_FROM": "Ministry Sites <forms@shofar.io>"
  },

  // Cloudflare Email Sending (needs a plan that includes it, and the sender domain onboarded under Email Sending).
  // To use it: uncomment, set EMAIL_PROVIDER to "cloudflare", redeploy.
  // "send_email": [{ "name": "EMAIL" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ministry-sites",
      // Paste the id printed by `wrangler d1 create ministry-sites`.
      "database_id": "8bdedc79-f57f-4445-84c3-cfc31174382b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "ministry-images" },
    // Rendered sites: published/<siteId>/index.html and published/<siteId>/images/*
    { "binding": "PUBLISHED", "bucket_name": "ministry-published" }
  ]
}
