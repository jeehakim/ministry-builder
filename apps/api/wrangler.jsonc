{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ministry-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Production hostname on the shofar.io zone (DNS and TLS managed by Cloudflare).
  // sites.shofar.io serves published sites straight from the PUBLISHED bucket (see src/hosting.ts).
  "routes": [
    { "pattern": "api.build.shofar.io", "custom_domain": true },
    { "pattern": "sites.shofar.io", "custom_domain": true }
  ],

  "vars": {
    // Origin of the web app allowed by CORS. Override per environment.
    "ALLOWED_ORIGIN": "https://build.shofar.io",
    // Chat model used by the AI copilot on OpenAI. Overridable per environment.
    "OPENAI_MODEL": "gpt-5-mini",
    // Claude model used by the AI copilot on Anthropic (AI_PROVIDER=anthropic or only ANTHROPIC_API_KEY set).
    "ANTHROPIC_MODEL": "claude-opus-5-5",
    // AI calls allowed per user per UTC day.
    "AI_DAILY_LIMIT": "30",
    // Hostname that serves published sites (path form: sites.shofar.io/<slug>/).
    "PUBLIC_SITES_HOST": "sites.shofar.io",
    // Contact-form notification emails: "cloudflare" (send_email binding below), "resend" (RESEND_API_KEY secret)
    // or "none" (store messages only; owners read them through GET /sites/:id/messages).
    "EMAIL_PROVIDER": "none",
    "EMAIL_FROM": "Ministry Sites <forms@shofar.io>"
  },

  // Cloudflare Email Sending (needs a plan that includes it, and the sender domain onboarded under Email Sending).
  // To use it: uncomment, set EMAIL_PROVIDER to "cloudflare", redeploy.
  // "send_email": [{ "name": "EMAIL" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ministry-sites",
      // Paste the id printed by `wrangler d1 create ministry-sites`.
      "database_id": "8bdedc79-f57f-4445-84c3-cfc31174382b",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "ministry-images" },
    // Rendered sites: published/<siteId>/index.html and published/<siteId>/images/*
    { "binding": "PUBLISHED", "bucket_name": "ministry-published" }
  ]
}
