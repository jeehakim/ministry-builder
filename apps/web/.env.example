# Clerk publishable key. Leave empty to run the editor in "local mode"
# (no sign-in, document stored in this browser's localStorage).
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the API worker.
VITE_API_URL=http://localhost:8787

# Production values are passed at build time, e.g.:
#   VITE_CLERK_PUBLISHABLE_KEY=pk_live_... VITE_API_URL=https://api.build.shofar.io pnpm deploy
