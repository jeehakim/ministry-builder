# Clerk publishable key. Leave empty to run the editor in "local mode"
# (no sign-in, document stored in this browser's localStorage).
# Local mode is for development only: a production build with this empty refuses to start.
# Production uses the shofar.ai Clerk application (the one behind social.shofar.ai), so a session
# signed in on any shofar.ai app is valid on build.shofar.ai too. Its frontend API host
# (clerk.shofar.ai) is also pinned in src/lib/csp.ts and public/_headers.
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the API worker.
VITE_API_URL=http://localhost:8787

# Production values are passed at build time (or put them in .env.production, which is not committed), e.g.:
#   VITE_CLERK_PUBLISHABLE_KEY=pk_live_... VITE_API_URL=https://api.build.shofar.ai pnpm deploy
