{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ministry-web",
  "compatibility_date": "2026-10-13",
  "observability": { "enabled": true },
  // Only the custom domains below are entry points; no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Production hostname on the shofar.ai zone (DNS and TLS managed by Cloudflare; `wrangler deploy` attaches it).
  // The API is api.build.shofar.ai (apps/api/wrangler.jsonc); hosted sites stay on sites.shofar.io.
  "routes": [{ "pattern": "build.shofar.ai", "custom_domain": true }],

  // Static SPA: every unknown path serves index.html so client routes like /sites/:id work.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
