{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ministry-web",
  "compatibility_date": "2026-10-13",
  "observability": { "enabled": true },

  // Production hostname on the shofar.io zone (DNS and TLS managed by Cloudflare).
  "routes": [{ "pattern": "build.shofar.io", "custom_domain": true }],

  // Static SPA: every unknown path serves index.html so client routes like /sites/:id work.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
